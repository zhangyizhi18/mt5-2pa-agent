# 默认按文本处理，仓库内统一 LF
* text=auto

# Windows 批处理必须 CRLF：LF-only 会让 cmd.exe 的 goto/标签定位错乱
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell 脚本保持 LF
*.sh text eol=lf
start.sh text eol=lf

# 二进制类型，禁止换行符转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.gz binary
*.tar binary
*.mp3 binary
*.wav binary
*.exe binary
*.dll binary
*.ex5 binary
