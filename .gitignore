# =============================================================================
# mt5-2pa-agent Git 忽略规则
# =============================================================================

# --- 运行凭据与密钥（严禁提交）---
.env
.env.*
!.env.example
config/settings.json
config/settings.local.json
config/users.json
config/secret.key
config/exception_state.json
config/.web-auth-token
*.pem
*.key
*.p12
*.pfx
*.token

# --- 运行数据、交易审计与日志 ---
/logs/*
!/logs/.gitkeep
/records/
/trade_records/
*.log
*.log.*
*.jsonl

# --- Rust 编译产物 ---
/target/
/dist/
*.exe
*.dll
*.so
*.dylib
*.pdb
*.rlib
*.rmeta
*.rs.bk

# --- 发行包与构建产物 ---
/release/
/dist-open-source/
*.zip
*.tar.gz
mql5/*.ex5
!mql5/PABridge.mq5

# --- 本机部署脚本（含主机凭据）与内部物料 ---
/deploy/
/promo/
/demo_video/
/免费AI注册.txt
/升级说明.txt
/启动服务.bat
.cargo/config.toml

# --- 临时与备份文件 ---
tmp/
temp/
.tmp/
*.tmp
*.bak
*.swp
*.swo
~$*

# --- 编辑器与操作系统专属文件 ---
.idea/
.vscode/
.cursor/
.agents/
.DS_Store
Thumbs.db
Desktop.ini
