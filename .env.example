# =============================================================================
# mt5-2pa-agent 环境配置示例
# 请复制为项目根目录的 .env，填写密钥后重启服务。
# .env 已被 Git 忽略，禁止提交、截图公开或发送给他人。
# =============================================================================

# ------------------------------ LLM 配置 ------------------------------
# OpenAI 兼容接口的 API Key；示例文件不填写真实密钥。
LLM_API_KEY=
# 当前 .env 默认使用 DeepSeek 官方或兼容接口；更换服务商时按其文档填写兼容接口根地址。
LLM_BASE_URL=https://api.deepseek.com
# 默认模型名称：deepseek-v4-flash
LLM_MODEL=deepseek-v4-flash
# 默认关闭思考模式；服务商支持且需要时可改为 true。
LLM_THINKING=false
# 思考强度：low、medium、high 或 max。
LLM_REASONING_EFFORT=high
# 模型上下文窗口大小，需不超过服务商限制。
LLM_CONTEXT_WINDOW=128000
# 阶段一、阶段二各自的最大等待秒数，范围 30-1800。
LLM_STAGE_TIMEOUT_SECONDS=240

# ------------------------------ 交易系统选择 ------------------------------
# 2pa = 2PA 价格行为系统；dog_walking = 遛狗系统；adaptive = 智能自适应双引擎
TRADING_SYSTEM=2pa

# ------------------------------ MT5 桥接 ------------------------------
# 与 PABridge EA 输入参数 BridgeToken 一致；留空表示不校验（仅建议本机监听时留空）。
MT5_BRIDGE_TOKEN=
# 与 PABridge EA 输入参数 MagicNumber 一致，用于识别本代理的订单。
MT5_MAGIC_NUMBER=20260907
# 等待 EA 回传执行结果的最长秒数。
MT5_COMMAND_TIMEOUT_SECONDS=20
# 超过该秒数未收到 EA 同步视为桥接断开。
MT5_BRIDGE_STALE_SECONDS=15

# ------------------------------ 交易环境 ------------------------------
# 服务启动时是否开启后台自动交易，建议保持 false。
MT5_AUTO_TRADING_ENABLED=false
# 实盘必须明确确认（模拟/实盘由 MT5 登录的账户类型自动识别）。
MT5_LIVE_TRADING_ACKNOWLEDGED=false

# ------------------------------ 订单与风控 ------------------------------
# 固定下单手数（自动算量关闭时生效）。例如黄金 0.1 手。
MT5_DEFAULT_ORDER_SIZE=0.1
# 仅用于保证金估算；MT5 实际杠杆以终端账户设置为准。
MT5_DEFAULT_LEVERAGE=100
# true=按账户净值/止损距离动态算量；false=使用固定手数。
MT5_AUTO_ORDER_SIZING=true
# 单笔风险占账户净值比例（%），范围 0.1-20。
MT5_RISK_PERCENT=2
# 单笔最大占用可用保证金比例（%），范围 1-100。
MT5_MAX_MARGIN_PERCENT=25
# true=已有持仓时禁止同品种继续开仓。
MT5_BLOCK_NEW_ENTRIES_WHEN_POSITION_OPEN=true
# 信号超过该秒数（从已收盘 K 线收盘时间计算）后不执行。
MT5_MAX_SIGNAL_AGE_SECONDS=120
# 未成交开仓挂单超过该数量的已收盘 K 线后自动撤销。
MT5_MAX_PENDING_BARS=3
# 后台检查新收盘 K 线的间隔秒数，不代表固定下单频率。
MT5_AUTOMATION_POLL_SECONDS=20

# ------------------------------ 交易时段 ------------------------------
# 自动交易分析时段：always、us_regular、us_open、london、asia 或 custom。
MT5_AUTOMATION_SESSION_PRESET=always
# custom 模式使用 IANA 时区、HH:MM 时间和星期编号（周一=0，周日=6）。
MT5_AUTOMATION_SESSION_TIMEZONE=Asia/Shanghai
MT5_AUTOMATION_SESSION_START=09:00
MT5_AUTOMATION_SESSION_END=16:00
MT5_AUTOMATION_SESSION_WEEKDAYS=0,1,2,3,4

# ------------------------------ Web 控制台账号 ------------------------------
# 仅在 config/users.json 不存在时用于创建内置账号，之后请在控制台「用户管理」中维护。
# 账号（含口令加盐哈希）保存在 config/users.json，不存明文。默认密码务必修改！
WEB_ADMIN_USERNAME=admin
WEB_ADMIN_PASSWORD=admin123
WEB_VIEWER_USERNAME=viewer
WEB_VIEWER_PASSWORD=viewer123
